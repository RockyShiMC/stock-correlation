# 复制为 .env 后填写。不要把 .env 提交到任何仓库。
# 本机开发若已在系统环境变量中设置，可留空；服务器部署必须填写。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# SQLite 文件路径，默认 backend/data.db
DB_PATH=

# ---- 网页版登录（必填）----
APP_USERNAME=
APP_PASSWORD=
# 会话签名密钥，至少 32 个字符。生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 只在 HTTPS 下发送 Cookie。本机 http 访问保持 false；部署在 Caddy 后面时由 compose 设为 true
COOKIE_SECURE=false
