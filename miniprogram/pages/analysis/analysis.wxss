.loading {
  text-align: center;
  padding: 48rpx 24rpx;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 20rpx;
  border: 6rpx solid #e5e8ec;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.retry {
  margin-top: 16rpx;
}

.pair {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 600;
}

.vs {
  color: #8a9099;
  font-weight: normal;
}

.grid {
  display: flex;
  margin-bottom: 12rpx;
}

.cell {
  flex: 1;
  text-align: center;
}

.num {
  font-size: 40rpx;
  font-weight: 600;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.row.gap {
  margin-top: 16rpx;
}

.num-sm {
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 16rpx;
}

.chart {
  width: 100%;
  height: 480rpx;
}

.summary {
  white-space: pre-wrap;
}

.note {
  margin-top: 12rpx;
  color: #8a6d00;
  font-size: 24rpx;
}

.chain-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.conf {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.conf-high { background: #e7f6ee; color: #1a7f4b; }
.conf-medium { background: #fff4e0; color: #a86400; }
.conf-low { background: #eef1f5; color: #4e5969; }

.evidence {
  margin-top: 16rpx;
  border-top: 1rpx solid #eef0f3;
}

.news {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.news:last-child {
  border-bottom: none;
}

.nid {
  color: #2f63c9;
  font-weight: 600;
  margin-right: 8rpx;
}

.link {
  color: #2f63c9;
  font-size: 22rpx;
  word-break: break-all;
}

.caveat {
  color: #4e5969;
  margin-bottom: 8rpx;
}

.footer-info {
  text-align: center;
}
