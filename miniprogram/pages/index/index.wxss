.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 16rpx;
}

.selected-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.remove {
  margin-left: auto;
  color: #c73a3a;
  font-size: 24rpx;
}

.compare-btn {
  margin-top: 20rpx;
}

.center {
  text-align: center;
  padding: 24rpx 0;
}

.list {
  padding: 0 24rpx;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.result-item:last-child {
  border-bottom: none;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #c9cdd4;
  border-radius: 8rpx;
  margin-right: 20rpx;
  text-align: center;
  line-height: 40rpx;
  color: #fff;
  font-size: 26rpx;
}

.checked .check {
  background: #07c160;
  border-color: #07c160;
}

.info {
  flex: 1;
}

.detail {
  color: #2f63c9;
  font-size: 26rpx;
  padding: 12rpx 0 12rpx 20rpx;
}
